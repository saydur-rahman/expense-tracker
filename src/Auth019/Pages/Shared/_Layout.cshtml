@{
    var title = ViewData["Title"] as string ?? "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — Expense Tracker</title>
    <style>
        :root { color-scheme: light dark; --bg:#eef2f7; --card:#f8fafc; --text:#0f1b2d; --muted:#64748b; --border:#dbe3ec; --input:#fff; --brand:#2563eb; --brand-hover:#1d4ed8; --danger:#dc2626; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg:#0b1220; --card:#141d2e; --text:#e6edf7; --muted:#8fa1bb; --border:#253248; --input:#0f1829; --brand:#3b82f6; --brand-hover:#60a5fa; --danger:#f87171; }
        }
        * { box-sizing: border-box; }
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
               background:var(--bg); color:var(--text); padding:1rem;
               font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
        .card { width:100%; max-width:24rem; background:var(--card); border:1px solid var(--border);
                border-radius:1rem; padding:1.75rem; box-shadow:0 1px 2px rgba(0,0,0,.05); }
        h1 { margin:0 0 1.25rem; font-size:1.35rem; text-align:center; }
        label { display:block; font-size:.875rem; font-weight:500; margin-bottom:.25rem; }
        .field { margin-bottom:1rem; }
        input[type=text],input[type=email],input[type=password],input[type=tel],select {
            width:100%; padding:.7rem .75rem; font-size:1rem; color:var(--text);
            background:var(--input); border:1px solid var(--border); border-radius:.5rem; }
        input:focus,select:focus { outline:2px solid var(--brand); outline-offset:-1px; border-color:var(--brand); }
        select { background:var(--card); }
        .field-error { display:block; color:var(--danger); font-size:.8125rem; margin-top:.35rem; }
        .hint { display:block; color:var(--muted); font-size:.8125rem; margin-top:.35rem; }
        button.primary { width:100%; padding:.8rem; font-size:1rem; font-weight:500; color:#fff;
                         background:var(--brand); border:0; border-radius:.5rem; cursor:pointer;
                         transition:background .15s ease; }
        button.primary:hover { background:var(--brand-hover); }
        .muted { color:var(--muted); font-size:.875rem; text-align:center; }
        .muted a { color:var(--brand); }
        .error { color:var(--danger); font-size:.875rem; margin-bottom:1rem; }
        .divider { display:flex; align-items:center; gap:.75rem; margin:1.25rem 0; color:var(--muted); font-size:.75rem; }
        .divider::before,.divider::after { content:""; flex:1; height:1px; background:var(--border); }
        button.external { width:100%; padding:.7rem; font-size:.95rem; color:var(--text);
                          background:transparent; border:1px solid var(--border); border-radius:.5rem; cursor:pointer;
                          transition:background .15s ease; }
        button.external:hover { background:rgba(127,127,127,.08); }
    </style>
</head>
<body>
    <main class="card">
        @RenderBody()
    </main>
</body>
</html>
